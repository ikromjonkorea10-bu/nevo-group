# Supabase loyihasi: Project Settings → API
# Bu ikki qiymat brauzerga ochiq bo'ladi — faqat anon (public) kalitni yozing.
# service_role kalitini BU FAYLGA HAM, FRONTEND'GA HAM HECH QACHON QO'YMANG.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Faqat `npm run import:catalog` uchun (brauzerga tushmaydi — VITE_ prefiksi yo'q).
# admin_users jadvaliga qo'shilgan admin foydalanuvchining email va paroli.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
